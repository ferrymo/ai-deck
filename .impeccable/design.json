      "css": ".ds-primary{font:12px/1.6 \"Segoe UI Variable\",\"Segoe UI\",\"Microsoft YaHei UI\",sans-serif;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,border-color 160ms ease;display:inline-flex;align-items:center;justify-content:center;min-height:35px;padding:7px 13px;border:0;border-radius:7px;background:var(--accent,#4263d8);color:var(--surface,#fff);font-weight:500;box-shadow:0 2px 3px #22399e13}.ds-primary:hover:not(:disabled){background:var(--accent-hover,#3453c4)}.ds-primary:focus-visible{outline:2px solid var(--accent,#4263d8);outline-offset:3px}.ds-primary:disabled{opacity:.48;cursor:not-allowed}"
    },

      "css": ".ds-secondary{font:12px/1.6 \"Segoe UI Variable\",\"Segoe UI\",\"Microsoft YaHei UI\",sans-serif;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,border-color 160ms ease;min-height:35px;padding:7px 13px;border:1px solid var(--border-strong,#dce0e7);border-radius:7px;background:var(--surface,#fff);color:var(--secondary,#515a68);font-weight:500}.ds-secondary:hover:not(:disabled){border-color:var(--faint,#9aa1ad);background:var(--hover,#f1f3f7)}.ds-secondary:focus-visible{outline:2px solid var(--accent,#4263d8);outline-offset:3px}.ds-secondary:disabled{opacity:.48;cursor:not-allowed}"
